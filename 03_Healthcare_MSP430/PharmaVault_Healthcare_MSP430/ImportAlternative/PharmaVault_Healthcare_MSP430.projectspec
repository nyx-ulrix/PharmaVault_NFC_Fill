<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
  <project name="PharmaVault_Healthcare_MSP430" device="MSP430F5529"
           connection="TIMSP430-USB.xml" toolChain="TI" toolVersion="21.6"
           configurations="Debug" outputType="executable" outputFormat="ELF"
           linkerCommandFile="../lnk_msp430f5529.cmd"
           compilerBuildOptions="-vmspx --code_model=small --data_model=small --define=__MSP430F5529__ --c99 --opt_level=2 --symdebug:dwarf --printf_support=nofloat --display_error_number --diag_wrap=off"
           linkerBuildOptions="--rom_model --stack_size=512 --heap_size=160 --use_hw_mpy=F5">
    <file path="../main.c" action="copy" openOnCreation="true"/>
    <file path="../rc522.c" action="copy"/>
    <file path="../rc522.h" action="copy"/>
    <file path="../hx711.c" action="copy"/>
    <file path="../hx711.h" action="copy"/>
    <file path="../PvProtocol.h" action="copy"/>
    <file path="../targetConfigs/MSP430F5529.ccxml" action="copy" targetDirectory="targetConfigs"/>
  </project>
</projectSpec>
